{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appmap-io",
  // AppMap (kevin@app.land) account — holds the appmap.io zone. Pinned so
  // deploys can never land in another Cloudflare account by accident.
  "account_id": "4ab8004254243d3c61f6262ba76936c1",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "vars": {
    "SUPABASE_URL": "https://ulrbnkrvxzbtqancxmtn.supabase.co",
    // Legacy docs/blog proxy origin: the Cloudflare Pages *branch alias* for
    // applandinc.github.io's feat/migrate-to-new-marketing-pages branch
    // (PR #1583) — the post-cutover old site. The alias tracks the branch's
    // latest build (name truncated to 28 chars by Pages). Known trade-off:
    // changed files can lag up to ~an hour at the edge after a push, and
    // deleted pages can serve stale forever — harmless here because the
    // worker itself redirects every deleted path before proxying. Once the
    // PR is merged and Render has rebuilt master, DELETE this var to fall
    // back to the Render origin (the old site's main branch).
    "LEGACY_ORIGIN": "https://feat-migrate-to-new-marketin.applandinc-github-io.pages.dev",
  },
  // Preview deploys use wrangler.preview.jsonc (a standalone config), NOT a
  // wrangler environment: nitro copies this file into the build output as a
  // "redirected" config, and wrangler rejects redirected configs that contain
  // environments (this broke the deploy-main CI job).
  // SUPABASE_SERVICE_ROLE_KEY is a secret; set it once with:
  //   bunx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
}
