{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appmap-io",
  // AppMap (kevin@app.land) account — holds the appmap.io zone. Pinned so
  // deploys can never land in another Cloudflare account by accident.
  "account_id": "4ab8004254243d3c61f6262ba76936c1",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [{ "pattern": "appmap.io/*", "zone_name": "appmap.io" }],
  // Paired with `wrangler preview` in deploy-preview.yml. Worker Previews
  // require this block to exist; it may be empty when the Preview needs no
  // settings of its own. If a Preview should ever point at a branch build of
  // the legacy site rather than its production deploy, a
  // "vars": { "LEGACY_ORIGIN": "..." } here is the hook for it (see
  // legacyOrigin() in src/server.ts).
  //
  // Unlike environments, "previews" is accepted in the redirected config
  // nitro writes to .output/server/wrangler.json — verified by a passing
  // deploy-preview run, not assumed.
  "previews": {},
  "vars": {
    "SUPABASE_URL": "https://ulrbnkrvxzbtqancxmtn.supabase.co",
    // Legacy docs/blog proxy origin: no LEGACY_ORIGIN var here means the
    // worker uses its default, the Cloudflare Pages build of
    // applandinc.github.io master (see DEFAULT_LEGACY_ORIGIN in
    // src/server.ts). PR #1583 merged 2026-09-04, so master is the
    // post-cutover old site. Render was retired as the legacy origin
    // 2026-10-15.
  },
  // Preview deploys use wrangler.preview.jsonc (a standalone config), NOT a
  // wrangler environment: nitro copies this file into the build output as a
  // "redirected" config, and wrangler rejects redirected configs that contain
  // environments (this broke the deploy-main CI job).
  // SUPABASE_SERVICE_ROLE_KEY is a secret; set it once with:
  //   bunx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
}
