{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appmap-io",
  // AppMap (kevin@app.land) account — holds the appmap.io zone. Pinned so
  // deploys can never land in another Cloudflare account by accident.
  "account_id": "4ab8004254243d3c61f6262ba76936c1",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "vars": {
    "SUPABASE_URL": "https://ulrbnkrvxzbtqancxmtn.supabase.co",
  },
  // Preview worker: separate name, own workers.dev URL, no production routes.
  // Deploy with:  npm run build && npx wrangler deploy --env preview --config .output/server/wrangler.json
  // LEGACY_ORIGIN points at the Cloudflare Pages preview of applandinc.github.io
  // PR #1583 (feat/migrate-to-new-marketing-pages). Pages preview URLs are
  // per-deployment: a new push to that PR mints a new hash, so update this
  // value from the PR's "Cloudflare Pages" check when the branch changes.
  "env": {
    "preview": {
      "vars": {
        "SUPABASE_URL": "https://ulrbnkrvxzbtqancxmtn.supabase.co",
        "LEGACY_ORIGIN": "https://73653cb0.applandinc-github-io.pages.dev",
      },
    },
  },
  // SUPABASE_SERVICE_ROLE_KEY is a secret; set it once with:
  //   bunx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
}
